# Used only for local `npm run dev` (outside Docker). When running via
# `docker compose up`, the app container's DATABASE_URL is set automatically
# in docker-compose.yml to reach the postgres service directly.
DATABASE_URL="postgresql://indocycle:indocycle@localhost:5433/indocycle_ledger?sslmode=disable"

# Required. Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-openssl-rand--base64-32-output"
NEXTAUTH_URL="http://localhost:3000"

# Seeded as the first admin user on first startup (only if no users exist yet).
ADMIN_NAME="Admin"
ADMIN_EMAIL="admin@indocycle.local"
ADMIN_PASSWORD="change-me-now"

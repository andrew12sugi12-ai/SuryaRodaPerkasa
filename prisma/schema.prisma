generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  INCOME
  EXPENSE
}

enum NormalBalance {
  DEBIT
  CREDIT
}

enum Role {
  ADMIN
  BOOKKEEPER
}

enum JournalSourceType {
  MANUAL
  PURCHASE
  SALE_REVENUE
  SALE_COGS
  EXPENSE
  PAYMENT
  ADJUSTMENT
  LANDED_COST
  SALE_RETURN
}

enum ExpenseCategory {
  COGS
  OPERATIONAL
  FIXED
  SALES
  OTHER
}

enum PaymentType {
  CUSTOMER_RECEIPT
  SUPPLIER_PAYMENT
}

enum PaymentMethod {
  CASH
  TRANSFER
  GIRO
  CEK
}

// Clearing state for a giro/cek payment. Null for cash/transfer.
enum GiroStatus {
  PENDING
  CLEARED
  BOUNCED
}

enum ProductCategory {
  SPAREPART
  BICYCLE
}

model User {
  id             String         @id @default(cuid())
  name           String
  email          String         @unique
  passwordHash   String
  role           Role           @default(BOOKKEEPER)
  isActive       Boolean        @default(true)
  failedLoginCount Int          @default(0)
  lockedUntil    DateTime?
  twoFactorEnabled Boolean      @default(false)
  twoFactorSecret String?
  createdAt      DateTime       @default(now())
  journalEntries JournalEntry[]
  auditLogs      AuditLog[]
}

model AuditLog {
  id        String   @id @default(cuid())
  action    String
  detail    String
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model PeriodLock {
  id            String   @id @default(cuid())
  lockedThrough DateTime
  createdById   String
  createdAt     DateTime @default(now())
}

model Account {
  id              String           @id @default(cuid())
  code            String           @unique
  name            String
  type            AccountType
  normalBalance   NormalBalance
  expenseCategory ExpenseCategory?
  isLongTerm      Boolean          @default(false)
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())

  journalLines       JournalLine[]
  purchasesAsPayment Purchase[]    @relation("PurchasePaymentAccount")
  salesAsPayment     Sale[]        @relation("SalePaymentAccount")
  payments           Payment[]     @relation("PaymentAccount")

  @@index([type])
}

model JournalEntry {
  id          String            @id @default(cuid())
  date        DateTime
  memo        String?
  reference   String?
  sourceType  JournalSourceType @default(MANUAL)
  createdById String
  createdBy   User              @relation(fields: [createdById], references: [id])
  createdAt   DateTime          @default(now())

  lines          JournalLine[]
  purchase       Purchase?         @relation("PurchaseJournal")
  saleRevenue    Sale?             @relation("SaleRevenueJournal")
  saleCOGS       Sale?             @relation("SaleCOGSJournal")
  payment        Payment?          @relation("PaymentJournal")
  returnRevenue  SalesReturn?      @relation("ReturnRevenueJournal")
  returnCOGS     SalesReturn?      @relation("ReturnCOGSJournal")

  @@index([date])
}

model JournalLine {
  id             String       @id @default(cuid())
  journalEntryId String
  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  accountId      String
  account        Account      @relation(fields: [accountId], references: [id])
  debit          Decimal      @default(0) @db.Decimal(18, 2)
  credit         Decimal      @default(0) @db.Decimal(18, 2)
  description    String?

  @@index([accountId])
  @@index([journalEntryId])
}

model Product {
  id             String          @id @default(cuid())
  sku            String          @unique
  name           String
  description    String?
  category       ProductCategory @default(SPAREPART)
  unitCost       Decimal         @default(0) @db.Decimal(18, 2)
  unitPrice      Decimal         @default(0) @db.Decimal(18, 2)
  quantityOnHand Decimal         @default(0) @db.Decimal(18, 3)
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())

  purchaseLines    PurchaseLine[]
  saleLines        SaleLine[]
  salesReturnLines SalesReturnLine[]

  // Bill of materials: a finished bike is assembled from component products.
  components  ProductComponent[] @relation("BikeComponents")   // if this is a bike: its parts
  usedInBikes ProductComponent[] @relation("ComponentOfBikes") // if this is a part: bikes using it
}

// One line of a bike's bill of materials: "this bike needs `quantity` of this component".
model ProductComponent {
  id          String  @id @default(cuid())
  bikeId      String
  componentId String
  quantity    Decimal @default(1) @db.Decimal(18, 3)

  bike      Product @relation("BikeComponents", fields: [bikeId], references: [id], onDelete: Cascade)
  component Product @relation("ComponentOfBikes", fields: [componentId], references: [id])

  @@unique([bikeId, componentId])
  @@index([componentId])
}

model Supplier {
  id             String  @id @default(cuid())
  name           String
  contactName    String?
  phone          String?
  email          String?
  address        String?
  isActive       Boolean   @default(true)
  openingBalance Decimal   @default(0) @db.Decimal(18, 2)

  purchases Purchase[]
  payments  Payment[]
}

// Sales rep (salesman) who owns a set of toko relationships. Promoted from a
// free-text field on Customer so we can track performance and targets.
model Salesman {
  id            String   @id @default(cuid())
  name          String
  phone         String?
  monthlyTarget Decimal  @default(0) @db.Decimal(18, 2)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())

  customers Customer[]
  sales     Sale[]
}

model Customer {
  id             String  @id @default(cuid())
  name           String
  contactName    String?
  phone          String?
  email          String?
  address        String?
  isActive       Boolean   @default(true)
  openingBalance Decimal   @default(0) @db.Decimal(18, 2)
  // Credit control (B2B tempo terms)
  creditLimit    Decimal   @default(0) @db.Decimal(18, 2)
  termDays       Int       @default(0)
  // Legacy free-text salesman name; superseded by salesmanId. Kept so existing
  // data is not lost during the migration.
  salesman       String?
  salesmanId     String?
  salesmanRel    Salesman? @relation(fields: [salesmanId], references: [id])
  cashOnly       Boolean   @default(false)

  sales         Sale[]
  payments      Payment[]
  salesReturns  SalesReturn[]

  @@index([salesmanId])
}

model Payment {
  id             String       @id @default(cuid())
  date           DateTime
  type           PaymentType
  customerId     String?
  customer       Customer?    @relation(fields: [customerId], references: [id])
  supplierId     String?
  supplier       Supplier?    @relation(fields: [supplierId], references: [id])
  accountId      String
  account        Account      @relation("PaymentAccount", fields: [accountId], references: [id])
  amount         Decimal      @db.Decimal(18, 2)
  // Actual IDR that moved through the cash/bank account. Differs from `amount`
  // only for foreign-currency settlements; the gap is the FX gain/loss
  // (Selisih Kurs). Null = same as `amount` (ordinary IDR payment).
  cashAmount     Decimal?     @db.Decimal(18, 2)
  // Payment method & giro/cek detail.
  method           PaymentMethod @default(TRANSFER)
  instrumentNumber String?      // giro/cek number
  instrumentBank   String?      // issuing bank of the giro/cek
  dueDate          DateTime?    // giro effective/clearing date
  giroStatus       GiroStatus?  // PENDING/CLEARED/BOUNCED for giro/cek; null otherwise
  bounceReason     String?
  // For a giro/cek: the clearing or bounce journal entry (second posting).
  clearJournalEntryId String?
  // Early-payment discount (potongan pelunasan) given on a customer receipt.
  discount       Decimal?     @db.Decimal(18, 2)
  // Uploaded proof (bukti transfer / giro photo), stored on the server disk.
  attachmentPath String?
  attachmentName String?
  attachmentType String?
  reference      String?
  memo           String?
  journalEntryId String       @unique
  journalEntry   JournalEntry @relation("PaymentJournal", fields: [journalEntryId], references: [id])
  createdById    String
  createdAt      DateTime     @default(now())

  @@index([customerId])
  @@index([supplierId])
  @@index([date])
  @@index([giroStatus])
}

model Purchase {
  id               String   @id @default(cuid())
  date             DateTime
  dueDate          DateTime?
  supplierId       String
  supplier         Supplier @relation(fields: [supplierId], references: [id])
  reference        String?
  paymentAccountId String
  paymentAccount   Account  @relation("PurchasePaymentAccount", fields: [paymentAccountId], references: [id])
  totalAmount      Decimal  @db.Decimal(18, 2)
  journalEntryId   String       @unique
  journalEntry     JournalEntry @relation("PurchaseJournal", fields: [journalEntryId], references: [id])
  createdById      String
  createdAt        DateTime @default(now())

  lines PurchaseLine[]

  @@index([supplierId])
  @@index([date])
}

model PurchaseLine {
  id         String   @id @default(cuid())
  purchaseId String
  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id])
  quantity   Decimal  @db.Decimal(18, 3)
  unitCost   Decimal  @db.Decimal(18, 2)
  lineTotal  Decimal  @db.Decimal(18, 2)

  @@index([productId])
}

model Sale {
  id                    String       @id @default(cuid())
  date                  DateTime
  dueDate               DateTime?
  customerId            String
  customer              Customer     @relation(fields: [customerId], references: [id])
  // Salesman credited for this sale. Defaults to the toko's assigned rep but can
  // be overridden per sale; kept on the sale so history stays accurate.
  salesmanId            String?
  salesman              Salesman?    @relation(fields: [salesmanId], references: [id])
  reference             String?
  paymentAccountId      String
  paymentAccount        Account      @relation("SalePaymentAccount", fields: [paymentAccountId], references: [id])
  totalAmount           Decimal      @db.Decimal(18, 2)
  totalCOGS             Decimal      @db.Decimal(18, 2)
  revenueJournalEntryId String       @unique
  revenueJournalEntry   JournalEntry @relation("SaleRevenueJournal", fields: [revenueJournalEntryId], references: [id])
  cogsJournalEntryId    String       @unique
  cogsJournalEntry      JournalEntry @relation("SaleCOGSJournal", fields: [cogsJournalEntryId], references: [id])
  createdById           String
  createdAt             DateTime     @default(now())

  lines         SaleLine[]
  salesReturns  SalesReturn[]

  @@index([customerId])
  @@index([salesmanId])
  @@index([date])
}

model SaleLine {
  id         String  @id @default(cuid())
  saleId     String
  sale       Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId  String
  product    Product @relation(fields: [productId], references: [id])
  quantity   Decimal @db.Decimal(18, 3)
  unitPrice  Decimal @db.Decimal(18, 2)
  unitCost   Decimal @db.Decimal(18, 2)
  lineTotal  Decimal @db.Decimal(18, 2)
  lineCOGS   Decimal @db.Decimal(18, 2)

  @@index([productId])
}

// Nota Retur / Nota Kredit — a sales return against a sale.
model SalesReturn {
  id            String   @id @default(cuid())
  number        String?  // nota kredit number
  date          DateTime
  saleId        String
  sale          Sale     @relation(fields: [saleId], references: [id])
  customerId    String
  customer      Customer @relation(fields: [customerId], references: [id])
  reason        String?
  totalAmount   Decimal  @db.Decimal(18, 2) // revenue reduced
  totalCOGS     Decimal  @db.Decimal(18, 2) // inventory restored
  restock       Boolean  @default(true)     // false = scrap to damaged goods
  // true when the original sale was on credit, so the return reduces AR.
  settledToAR   Boolean  @default(false)
  revenueJournalEntryId String       @unique
  revenueJournalEntry   JournalEntry @relation("ReturnRevenueJournal", fields: [revenueJournalEntryId], references: [id])
  cogsJournalEntryId    String?      @unique
  cogsJournalEntry      JournalEntry? @relation("ReturnCOGSJournal", fields: [cogsJournalEntryId], references: [id])
  createdById   String
  createdAt     DateTime @default(now())

  lines SalesReturnLine[]

  @@index([saleId])
  @@index([customerId])
  @@index([date])
}

model SalesReturnLine {
  id             String      @id @default(cuid())
  salesReturnId  String
  salesReturn    SalesReturn @relation(fields: [salesReturnId], references: [id], onDelete: Cascade)
  productId      String
  product        Product     @relation(fields: [productId], references: [id])
  quantity       Decimal     @db.Decimal(18, 3)
  unitPrice      Decimal     @db.Decimal(18, 2)
  unitCost       Decimal     @db.Decimal(18, 2)
  lineTotal      Decimal     @db.Decimal(18, 2)
  lineCOGS       Decimal     @db.Decimal(18, 2)

  @@index([productId])
}
